{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {"distDir": "vercel-dist"}
    }
  ],
  "headers": [
    {
      "source": "/apk/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=interest-class.apk"
        },
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        }
      ]
    }
  ]
}
